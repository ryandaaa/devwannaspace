{
  "name": "new-web-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run dev -w api",
    "dev:mobile": "npm run web -w mobile",
    "build:web": "npm run build -w web",
    "build:api": "npm run deploy -w api",
    "setup": "node setup.mjs"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "picocolors": "^1.1.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.2",
    "@rolldown/binding-darwin-x64": "^1.2.2",
    "@rolldown/binding-linux-x64-gnu": "^1.2.2",
    "@rolldown/binding-win32-x64-msvc": "^1.2.2"
  }
}
